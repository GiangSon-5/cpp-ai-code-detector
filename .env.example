# ==============================================================================
# 🕵️‍♂️ C++ AI Code Detector — Environment Configuration Template
# Copy this file to .env and adjust the values for your local or production setup:
#   cp .env.example .env
# ==============================================================================

# --- Django Web App Settings ---
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-random-secret-key-32chars
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- AI Orchestrator & Worker Connection ---
# If using Google Colab GPU Worker via ngrok, paste the ngrok tunnel URL here:
# FASTAPI_AI_URL=https://xxxx-xxxx.ngrok-free.dev
# If running Local GPU Worker (port 8002):
FASTAPI_AI_URL=http://localhost:8002
COLAB_API_KEY=colab-secret-key-123
LOCAL_GPU_API_KEY=local-gpu-secret-key-123

# --- PostgreSQL Database (Docker-compose default) ---
DB_NAME=cpp_detector
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# --- Redis & Celery Background Workers ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Redpanda / Kafka Event Streaming (Optional) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDPANDA_API_URL=http://localhost:18081

# --- DagsHub / S3 Data Lake (Medallion Bronze & Silver Storage) ---
DAGSHUB_REPO_OWNER=
DAGSHUB_REPO_NAME=
DAGSHUB_TOKEN=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Third-party AI Services (Optional Fallbacks) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
NGROK_TOKEN=

# --- Local GPU Server Weights (If running GPU locally) ---
# LOCAL_MODEL_PATH_OOP=./local_models/fold_1_oop
# LOCAL_MODEL_PATH_NORMAL=./local_models/fold_1_basic
