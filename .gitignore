# ==============================================================================
# Git Ignore Rules — C++ AI Code Detector & MLOps Platform
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
venv/
ENV/
env/

# Django framework
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Model checkpoints & large binary weights (Use DagsHub/S3/DVC)
*.h5
*.pth
*.pt
*.bin
*.pkl
*.onnx
*.safetensors
models/
local_models/
Saved_Models/
data/
datasets/

# Data lake local cache (Keep folder structure via .gitkeep)
data_lake/bronze/*
!data_lake/bronze/.gitkeep
data_lake/silver/*
!data_lake/silver/.gitkeep
data_lake/gold/*
!data_lake/gold/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Document drafts & temporary files
*.docx
*.pptx
rate_limits_by_model.json
test_gemini/
behavioral_insights_rewrite.txt
